# Contoh konfigurasi lingkungan PRDAI.
# Salin berkas ini menjadi ".env" lalu isi nilainya. JANGAN commit berkas ".env".

# --- Aplikasi ---
APP_ENV=production
APP_URL=https://prdai.contoh.com
APP_ZONA_WAKTU=Asia/Jakarta
REGISTRASI_TERBUKA=true
SESI_KADALUARSA_DETIK=31536000

# --- Basis data ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAMA=prdai
DB_PENGGUNA=
DB_KATA_SANDI=

# --- Keamanan ---
# Isi dengan 32 byte acak. Contoh membuat: openssl rand -hex 32
ENCRYPTION_KEY=

# --- AI ---
AI_PENYEDIA=anthropic
AI_API_KEY=
AI_MODEL=
AI_MAKS_TOKEN=8000
AI_TIMEOUT_DETIK=120
AI_BATAS_HARIAN=10